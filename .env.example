# 服务监听
PORT=8787
HOST=0.0.0.0

# 对外访问地址：公网部署必须改成最终 HTTPS 域名，二维码会使用这个地址。
# 临时隧道也建议在获取域名后填写，或由反向代理的 X-Forwarded-Host 自动推断。
PUBLIC_BASE_URL=

# 数据库与上传文件目录（默认 ./data）
# JIANJI_DATA_DIR=./data

# 课程表 OCR：ocrspace = 真实识别；http = 自建识别服务；mock = 固定演示数据
OCR_PROVIDER=ocrspace
# 默认 helloworld 仅供试用，正式使用请换成自己申请的 key。
OCR_SPACE_API_KEY=helloworld
# OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
# OCR_SPACE_LANGUAGE=chs

# OCR_PROVIDER=http 时使用
# OCR_ENDPOINT=https://ocr.example.com/v1/timetable
# OCR_API_KEY=
